msgid "Allowlisted Secret Directories"
msgstr "Galalka Siraha ee Liiska Oggolaanshaha"

#: lib/Settings.php
msgid "Colon-separated list of absolute directories permitted for file: secret references (files must be mode 0400 or 0600 with no symlinks)."
msgstr "Liis galal buuxa oo labo-dhibic kala soocdo kuwaas oo loo oggol yahay tixraacyada sirta file: (faylashu waa inay lahaadaan qaabka 0400 ama 0600 iyadoo aan lahayn xiriiriyeyaal astaan ah)."

#: lib/Settings.php
msgid "Baseline Manifest Path"
msgstr "Waddada Bayaan-habaynta Aasaasiga ah"

#: lib/Settings.php
msgid "Optional path to a declarative YAML or XML baseline manifest used by drift checks, Doctor checks, and MCP status abilities."
msgstr "Waddo ikhtiyaari ah oo u socota bayaan-habayn aasaasi ah oo caddayn ah oo YAML ama XML ah oo ay adeegsadaan hubinta leexashada, hubinta Doctor, iyo awoodaha xaaladda MCP."

#: lib/Settings.php
msgid "Keep Audit Tables on Uninstall"
msgstr "Hay Jadwallada Baaritaanka Marka la Tirtiro"

#: lib/Settings.php
msgid "Preserve plugin_casc_audit and plugin_casc_plan tables when uninstalling the plugin."
msgstr "Xafid jadwallada plugin_casc_audit iyo plugin_casc_plan marka la tirtirayo kordhinta."

