msgid "Preserve plugin_casc_audit and plugin_casc_plan tables when uninstalling the plugin."
msgstr "Gcina iitheyibhile ze-plugin_casc_audit kunye ne-plugin_casc_plan xa kukhutshwa isongezelelo."

