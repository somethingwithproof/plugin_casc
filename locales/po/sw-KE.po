#: lib/Settings.php
msgid "Baseline Manifest Path"
msgstr "Njia ya Manifesti ya Msingi"

#: lib/Settings.php
msgid "Optional path to a declarative YAML or XML baseline manifest used by drift checks, Doctor checks, and MCP status abilities."
msgstr "Njia ya hiari kuelekea manifesti ya msingi ya tamko ya YAML au XML inayotumiwa na ukaguzi wa mkengeuko, ukaguzi wa Doctor, na uwezo wa hali wa MCP."

#: lib/Settings.php
msgid "Keep Audit Tables on Uninstall"
msgstr "Hifadhi Majedwali ya Ukaguzi Wakati wa Kuondoa"

#: lib/Settings.php
msgid "Preserve plugin_casc_audit and plugin_casc_plan tables when uninstalling the plugin."
msgstr "Hifadhi majedwali ya plugin_casc_audit na plugin_casc_plan wakati wa kuondoa programu-jalizi."

