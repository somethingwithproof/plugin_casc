#: lib/Settings.php
msgid "Baseline Manifest Path"
msgstr "Hanyar Fayil ɗin Bayani na Asali"

#: lib/Settings.php
msgid "Optional path to a declarative YAML or XML baseline manifest used by drift checks, Doctor checks, and MCP status abilities."
msgstr "Hanya ta zaɓi zuwa fayil ɗin bayani na asali na YAML ko XML da binciken karkacewa, binciken Doctor, da damar matsayin MCP ke amfani da shi."

#: lib/Settings.php
msgid "Keep Audit Tables on Uninstall"
msgstr "Ajiye Teburan Bincike Lokacin Cire Manhaja"

#: lib/Settings.php
msgid "Preserve plugin_casc_audit and plugin_casc_plan tables when uninstalling the plugin."
msgstr "Kiyaye teburan plugin_casc_audit da plugin_casc_plan lokacin cire ƙarin manhajar."

