msgstr "Tahirizina ny Tabilao Fanaraha-maso Rehefa Esorina"

#: lib/Settings.php
msgid "Preserve plugin_casc_audit and plugin_casc_plan tables when uninstalling the plugin."
msgstr "Tahirizina ny tabilao plugin_casc_audit sy plugin_casc_plan rehefa esorina ny fanampiny."

