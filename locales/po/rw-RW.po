msgid "Preserve plugin_casc_audit and plugin_casc_plan tables when uninstalling the plugin."
msgstr "Gukomeza kubika imbonerahamwe za plugin_casc_audit na plugin_casc_plan mu gihe cyo kuvanaho umugereka."

