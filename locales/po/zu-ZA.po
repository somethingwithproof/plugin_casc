#: lib/Settings.php
msgid "Baseline Manifest Path"
msgstr "Indlela Yemanifesti Yesisekelo"

#: lib/Settings.php
msgid "Optional path to a declarative YAML or XML baseline manifest used by drift checks, Doctor checks, and MCP status abilities."
msgstr "Indlela ongazikhethela yona eya kwimanifesti yesisekelo echazayo ye-YAML noma ye-XML esetshenziswa ukuhlolwa kokuphambuka, ukuhlolwa kwe-Doctor, kanye namakhono esimo e-MCP."

#: lib/Settings.php
msgid "Keep Audit Tables on Uninstall"
msgstr "Gcina Amathebula Okuhlola Lapho Ukhipha"

#: lib/Settings.php
msgid "Preserve plugin_casc_audit and plugin_casc_plan tables when uninstalling the plugin."
msgstr "Gcina amathebula athi plugin_casc_audit kanye nelithi plugin_casc_plan lapho ukhipha isengezo."

